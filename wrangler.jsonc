{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odd-sunset-6c83",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAM_DATA_CENTER_B_RELEASE_GATE": "false"
  },
  "kv_namespaces": [
    {
      "binding": "MAM_KV",
      "id": "4de80ce8f698470e833d9773d6724b94"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mac-analiz-arsiv",
      "database_id": "b3103550-8f93-4109-8a24-e0095c49e666"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "mac-analiz-preview",
        "database_id": "704a5c24-491f-455f-b62a-23752083f085"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "MAM_KV",
        "id": "5e90bdd4b76c4a2eb7a88381966f0f3e"
      }
    ],
    "vars": {
      "HISTORY_BACKFILL_PILOT_ENABLED": "true",
      "MAM_DATA_CENTER_B_RELEASE_GATE": "false"
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *", "1 21 * * *"]
  }
}
