{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odd-sunset-6c83",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "MAM_KV",
      "id": "4de80ce8f698470e833d9773d6724b94"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mac-analiz-arsiv",
      "database_id": "b3103550-8f93-4109-8a24-e0095c49e666"
    }
  ],
  "previews": {
    "d1_databases": [],
    "kv_namespaces": [],
    "vars": {
      "HISTORY_BACKFILL_PILOT_ENABLED": "false"
    }
  },
  "triggers": {
    "crons": ["5 0 * * *", "15,30,45 0 * * *", "*/15 1-23 * * *"]
  }
}